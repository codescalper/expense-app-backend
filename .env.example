# Copy to .env and adjust. Never commit the real .env.
# Full reference: docs/ENVIRONMENT.md

ENVIRONMENT=development

# --- Database -------------------------------------------------------------
# Local Docker Compose Postgres. Inside compose the api/worker override the host to "postgres".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/family_budget
# Optional: direct (non-pooled) URL used only by Alembic. Neon: use the non "-pooler" host here.
# DATABASE_MIGRATION_URL=
# Set true when DATABASE_URL points at a PgBouncer / Neon "-pooler" endpoint.
DB_PGBOUNCER=false
# Used by pytest (separate database, created by infra/postgres/init.sql)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/family_budget_test

# --- Auth -----------------------------------------------------------------
# At least 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- HTTP -----------------------------------------------------------------
# Comma-separated allowlist. Native mobile apps don't need CORS; this is for web clients / Expo web.
CORS_ORIGINS=http://localhost:8081
ENABLE_DOCS=true

# --- Email (dev: Mailpit, inbox UI at http://localhost:8025) ----------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
EMAIL_FROM=Family Budget <no-reply@familybudget.local>

# --- Files ----------------------------------------------------------------
UPLOAD_DIR=./data/uploads
