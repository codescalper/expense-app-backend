{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,alembic/**,alembic.ini,scripts/**,data/**,**/__pycache__/**,.pytest_cache/**,.mypy_cache/**,.ruff_cache/**,Dockerfile,requirements-dev.in,requirements-dev.txt}"
    }
  },
  "crons": [
    {
      "path": "/internal/cron/tick",
      "schedule": "17 3 * * *"
    }
  ],
  "regions": [
    "iad1"
  ]
}
