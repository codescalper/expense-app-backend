# Vercel (serverless) + Neon deployment settings. Names only: every value below is a placeholder.
# Copy to .env.vercel (git-ignored) for backend/scripts/migrate_remote.*, and add the same
# variables to the Vercel project (Production) with `vercel env add`. Guide: docs/VERCEL.md
# Lines marked SECRET must only ever live in .env.vercel and in Vercel's env store.

ENVIRONMENT=production
ENABLE_DOCS=false
CORS_ORIGINS=

# --- Runtime mode -----------------------------------------------------------------------------
SERVERLESS=true
EMAIL_DELIVERY=inline
STORAGE_BACKEND=s3
TRUST_VERCEL_PROXY=true

# --- Database (Neon) --------------------------------------------------------------------------
# SECRET. Pooled host (-pooler), least-privilege app role.
DATABASE_URL=postgresql://fb_app:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/family_budget?sslmode=require
DB_PGBOUNCER=true
# SECRET. Direct host, owner role. Used only by Alembic (migrate_remote.*); do NOT add it to
# Vercel: the deployed app never needs DDL rights.
DATABASE_MIGRATION_URL=postgresql://fb_owner:<password>@ep-xxxx.<region>.aws.neon.tech/family_budget?sslmode=require

# --- Auth -------------------------------------------------------------------------------------
# SECRET. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<random-48-bytes>

# --- Cron -------------------------------------------------------------------------------------
# SECRET. Letters and digits only, 32+ chars: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=<random-hex>
CRON_TIME_BUDGET_SECONDS=50

# --- Email (SMTP provider) ----------------------------------------------------------------------
SMTP_HOST=<smtp.provider.example>
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USE_TLS=false
SMTP_USERNAME=<smtp-user>
# SECRET
SMTP_PASSWORD=<smtp-password>
EMAIL_FROM=Family Budget <no-reply@your-domain.example>

# --- Files: private bucket on S3-compatible storage (Neon object storage) ------------------------
S3_ENDPOINT_URL=https://<id>.storage.<cell>.<region>.aws.neon.tech
S3_REGION=us-east-2
S3_BUCKET=<bucket-name>
# SECRET (both)
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
# Alternative: STORAGE_BACKEND=vercel_blob with a PRIVATE Vercel Blob store instead of S3_*.
# BLOB_READ_WRITE_TOKEN=<vercel_blob_rw_token>   (SECRET)
# Vercel rejects request bodies over 4.5 MB, so keep receipts below that.
MAX_RECEIPT_BYTES=4194304

# --- Push (optional) ----------------------------------------------------------------------------
PUSH_ENABLED=true
# SECRET, only if "enhanced push security" is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=<expo-access-token>
